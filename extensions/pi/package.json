{
	"name": "codesafe-pi",
	"version": "1.5.0",
	"description": "codesafe extension for Pi/OMP — intent hints, safe commit/delete tools, commit/diff rule checks",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LingyeNBird/codesafe.git",
		"directory": "extensions/pi"
	},
	"homepage": "https://github.com/LingyeNBird/codesafe",
	"bugs": "https://github.com/LingyeNBird/codesafe/issues",
	"type": "module",
	"keywords": [
		"pi-package",
		"codesafe",
		"conventional-commits",
		"commit-safety"
	],
	"files": [
		"index.ts",
		"core/",
		"bin/",
		"scripts/",
		"README.md"
	],
	"bin": {
		"codesafe": "./bin/codesafe.js"
	},
	"scripts": {
		"postinstall": "node scripts/postinstall.js"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"omp": {
		"extensions": [
			"./index.ts"
		]
	}
}
